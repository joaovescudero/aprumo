# Aprumo environment variables — copy to .env and fill in real values.
# NEVER commit .env with real passwords. gitleaks (pre-commit) will block it.

# Database URL for migrations (uses aprumo_migration role which has DDL access).
DATABASE_URL=postgres://aprumo_migration:changeme@localhost:5432/aprumo

# For app connections (after roles migration — aprumo_app has SELECT/INSERT only, no UPDATE/DELETE on postings/raw_events).
# DATABASE_APP_URL=postgres://aprumo_app:changeme@localhost:5432/aprumo

# Postgres password — used by docker-compose.yml as POSTGRES_PASSWORD.
# Default in docker-compose is "changeme"; set a real password in non-dev environments.
POSTGRES_PASSWORD=changeme

# Node environment. Set to "production" to prevent db:reset from running.
NODE_ENV=development
